name: Build APK
on: workflow_dispatch
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: subosito/flutter-action@v2
        with:
          channel: stable
      
      - name: Create Flutter Project
        run: |
          flutter create --project-name phone_shop --platforms=android .
          mkdir -p lib
      
      - name: Copy Main Files
        run: |
          cp main.dart lib/main.dart 2>/dev/null || echo "main.dart not found, using default"
      
      - name: Add Dependencies
        run: flutter pub add shared_preferences mobile_scanner pdf printing local_auth
      
      - name: Update Android Config
        run: |
          # Set minSdkVersion to 24
          sed -i 's/minSdkVersion.*/minSdkVersion 24/' android/app/build.gradle || true
          
          # Add Permissions
          sed -i '/<application/i\    <uses-permission android:name="android.permission.CAMERA" />\n    <uses-permission android:name="android.permission.USE_BIOMETRIC" />' android/app/src/main/AndroidManifest.xml || true
          
          # Set App Label
          sed -i 's/android:label="[^"]*"/android:label="Al Itqan Store"/' android/app/src/main/AndroidManifest.xml || true
          
          # Update Activity (if MainActivity.kt exists)
          if [ -f android/app/src/main/kotlin/MainActivity.kt ]; then
            sed -i 's/FlutterActivity/FlutterFragmentActivity/g' android/app/src/main/kotlin/MainActivity.kt || true
          fi
      
      - name: Generate App Icon
        run: |
          pip install pillow
          cat > make_icon.py <<'PY'
          from PIL import Image, ImageDraw
          def create_icon(size, with_bg):
              im = Image.new('RGBA', (size, size), (0, 0, 0, 0))
              d = ImageDraw.Draw(im)
              
              if with_bg:
                  for y in range(size):
                      ratio = y / size
                      r = int(26 + 45 * ratio)
                      g = int(35 + 4 * ratio)
                      b = int(126 + 34 * ratio)
                      d.line([(0, y), (size, y)], fill=(r, g, b, 255))
              
              scale = size / 1024.0 * (1.0 if with_bg else 0.62)
              center = size / 2
              
              def draw_rect(x0, y0, x1, y1, radius, color):
                  coords = [
                      center + x0 * scale,
                      center + y0 * scale,
                      center + x1 * scale,
                      center + y1 * scale
                  ]
                  d.rounded_rectangle(coords, radius=int(radius * scale), fill=color)
              
              draw_rect(-200, -340, 200, 340, 60, (255, 255, 255, 255))
              draw_rect(-170, -290, 170, 270, 30, (30, 27, 90, 255))
              
              x_pos = -120
              widths = [14, 6, 22, 8, 12, 24, 6, 16, 10, 20, 7, 14]
              for w in widths:
                  draw_rect(x_pos, -120, x_pos + w, 60, 2, (255, 255, 255, 255))
                  x_pos += w + 8
              
              draw_rect(-40, 295, 40, 315, 10, (160, 160, 190, 255))
              
              circle_x, circle_y, circle_r = 170, 200, 130
              circle_bbox = [
                  center + (circle_x - circle_r) * scale,
                  center + (circle_y - circle_r) * scale,
                  center + (circle_x + circle_r) * scale,
                  center + (circle_y + circle_r) * scale
              ]
              d.ellipse(circle_bbox, fill=(255, 193, 7, 255), outline=(255, 255, 255, 255), width=int(14 * scale))
              
              line_width = int(30 * scale)
              d.line([
                  (center + (circle_x - 60) * scale, center + (circle_y + 5) * scale),
                  (center + (circle_x - 15) * scale, center + (circle_y + 50) * scale),
                  (center + (circle_x + 65) * scale, center + (circle_y - 45) * scale)
              ], fill=(26, 35, 126, 255), width=line_width, joint='curve')
              
              return im
          
          create_icon(1024, True).convert('RGB').save('icon.png')
          create_icon(1024, False).save('icon_fg.png')
          print("Icons created successfully")
          PY
          python make_icon.py
      
      - name: Configure Flutter Launcher Icons
        run: |
          cat > pubspec.yaml.patch <<'PATCH'
          dev_dependencies:
            flutter_launcher_icons: ^0.13.1
          flutter_icons:
            android: true
            ios: false
            image_path: "icon.png"
            adaptive_icon_background: "#1A237E"
            adaptive_icon_foreground: "icon_fg.png"
          PATCH
          
          dart run flutter_launcher_icons:main || echo "Icon generation skipped"
      
      - name: Get Dependencies
        run: flutter pub get
      
      - name: Build APK
        run: flutter build apk --release
      
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: app-release.apk
          path: build/app/outputs/flutter-apk/app-release.apk
          if-no-files-found: warn
