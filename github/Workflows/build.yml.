name: Build APK
on: workflow_dispatch
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: subosito/flutter-action@v2
        with:
          channel: stable
      - run: flutter create --project-name phone_shop --platforms=android .
      - run: cp main.dart lib/main.dart
      - run: flutter pub add shared_preferences mobile_scanner pdf printing local_auth:^2.3.0 crypto share_plus:^10.1.0 file_picker:^8.1.0 sqflite dev:flutter_launcher_icons
      - run: sed -i 's/flutter.minSdkVersion/24/' android/app/build.gradle*
      - run: sed -i 's#<application#<uses-permission android:name="android.permission.CAMERA"/><uses-permission android:name="android.permission.USE_BIOMETRIC"/><application#' android/app/src/main/AndroidManifest.xml
      - run: sed -i 's/android:label="[^"]*"/android:label="Al Itqan Store"/' android/app/src/main/AndroidManifest.xml
      - run: sed -i 's/FlutterActivity/FlutterFragmentActivity/g' $(find android -name MainActivity.kt)
      - run: sed -i 's#@android:style/Theme.Light.NoTitleBar#Theme.AppCompat.Light.NoActionBar#; s#@android:style/Theme.Black.NoTitleBar#Theme.AppCompat.NoActionBar#' android/app/src/main/res/values/styles.xml android/app/src/main/res/values-night/styles.xml || true
      - name: Make icon
        run: |
          pip install pillow
          cat > make_icon.py <<'PY'
          from PIL import Image, ImageDraw
          def art(S, bg):
              im = Image.new('RGBA', (S, S), (0, 0, 0, 0))
              d = ImageDraw.Draw(im)
              if bg:
                  for y in range(S):
                      t = y / S
                      d.line([(0, y), (S, y)], fill=(int(26 + 45 * t), int(35 + 4 * t), int(126 + 34 * t), 255))
              k = S / 1024.0 * (1.0 if bg else 0.62)
              c = S / 2
              def R(x0, y0, x1, y1, r, fill):
                  d.rounded_rectangle([c + x0 * k, c + y0 * k, c + x1 * k, c + y1 * k], radius=r * k, fill=fill)
              R(-200, -340, 200, 340, 60, (255, 255, 255, 255))
              R(-170, -290, 170, 270, 30, (30, 27, 90, 255))
              x = -120
              for w in [14, 6, 22, 8, 12, 24, 6, 16, 10, 20, 7, 14]:
                  R(x, -120, x + w, 60, 2, (255, 255, 255, 255))
                  x += w + 8
              R(-40, 295, 40, 315, 10, (160, 160, 190, 255))
              gx, gy, gr = 170, 200, 130
              d.ellipse([c + (gx - gr) * k, c + (gy - gr) * k, c + (gx + gr) * k, c + (gy + gr) * k], fill=(255, 193, 7, 255), outline=(255, 255, 255, 255), width=int(14 * k))
              d.line([(c + (gx - 60) * k, c + (gy + 5) * k), (c + (gx - 15) * k, c + (gy + 50) * k), (c + (gx + 65) * k, c + (gy - 45) * k)], fill=(26, 35, 126, 255), width=int(30 * k), joint='curve')
              return im
          art(1024, True).convert('RGB').save('icon.png')
          art(1024, False).save('icon_fg.png')
          PY
          python make_icon.py
          printf 'flutter_launcher_icons:\n  android: true\n  ios: false\n  image_path: "icon.png"\n  adaptive_icon_background: "#1A237E"\n  adaptive_icon_foreground: "icon_fg.png"\n' > flutter_launcher_icons.yaml
          dart run flutter_launcher_icons
      - name: Restore signing key
        env:
          KS: ${{ secrets.KEYSTORE_B64 }}
        run: |
          mkdir -p ~/.android
          if [ -n "$KS" ]; then echo "$KS" | base64 -d > ~/.android/debug.keystore; else echo "::warning::KEYSTORE_B64 secret missing, using a random key"; fi
      - run: flutter build apk --release
      - uses: actions/upload-artifact@v4
        with:
          name: apk
          path: build/app/outputs/flutter-apk/app-release.apk
